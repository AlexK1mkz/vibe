---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Recognition from '../components/Recognition.astro';
import Manifesto from '../components/Manifesto.astro';
import Season from '../components/Season.astro';
import Results from '../components/Results.astro';
import Tariffs from '../components/Tariffs.astro';
import About from '../components/About.astro';
