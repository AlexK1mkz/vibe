---
import { SITE } from '../data/site';
---

<section class="container cta-wrap">
  <div class="rv cta">
    <p class="kicker cta__kicker">Сезон 1 · Архитектура денег</p>
    <h2 class="cta__h2">Сезон стартует 10 октября. Дальше — с полем или без него.</h2>
    <div class="cta__btns">
      <a href={SITE.links.community} target="_blank" rel="noopener" class="btn btn--light cta__btn">Войти в Community</a>
      <button type="button" class="btn cta__btn cta__btn--ghost" data-open-form>Анкета на Master</button>
    </div>
    <p class="cta__note">
      Остались вопросы?
      <a href={SITE.links.care} target="_blank" rel="noopener">Напиши в службу заботы в Telegram</a>
    </p>
  </div>
</section>

<style>
  .cta-wrap { margin-top: var(--section-gap); }
  .cta {
    background: var(--brown);
    color: var(--cream);
    border-radius: 32px;
    padding: clamp(48px, 6vw, 80px) clamp(24px, 5vw, 72px);
    position: relative;
    overflow: hidden;
  }
  .cta__kicker { letter-spacing: .2em; margin-bottom: 24px; }
  .cta__h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: -.02em;
    max-width: 820px;
  }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
  .cta__btn { padding: 18px 30px; font-size: 15px; }
  .cta__btn--ghost { border: 1px solid var(--gold); background: transparent; color: var(--cream); }
  .cta__btn--ghost:hover { background: var(--brown-2); }
  .cta__note { font-size: 14px; color: var(--line-3); margin-top: 28px; }
  .cta__note a { color: var(--gold); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) { .cta-wrap { margin-top: 72px; } }
</style>
