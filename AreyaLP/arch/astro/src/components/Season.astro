---
import { QUESTIONS } from '../data/season';
import { SITE } from '../data/site';
---

<section id="season" class="sec container season">
  <div class="stack season__grid">
    <div class="rv">
      <p class="kicker season__kicker">Сезон 1 · {SITE.seasonDates}</p>
      <h2 class="h2">Архитектура денег</h2>
      <p class="season__lead">Не о том, как работать больше. О том, что поменять в себе и в деле, чтобы следующий уровень дохода стал естественным.</p>
      <p class="kicker kicker--muted season__for">Для кого</p>
      <div class="season__list">
        <p>Планируешь вырасти в доходе без выгорания</p>
        <p>Нужен не разовый скачок, а уровень без откатов</p>
        <p>Понимаешь: новый результат старыми способами не сделать</p>
      </div>
    </div>

    <div class="rv season__card">
      <p class="kicker kicker--muted">Шесть вопросов сезона</p>
      <div class="season__qs">
        {QUESTIONS.map((q) => (
          <div class="season__q">
            <span>{q.n}</span>
            <p>{q.t}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
  <p class="rv season__motto">Деньги — показатель конфигурации. Меняется конфигурация — меняются деньги.</p>
</section>

<style>
  .season__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  .season__kicker { letter-spacing: .2em; margin-bottom: 24px; }
  .season__lead { font-size: 17px; line-height: 1.65; color: var(--ink-2); margin-top: 28px; }
  .season__for { margin-top: 40px; }
  .season__list { display: flex; flex-direction: column; margin-top: 12px; }
  .season__list p { padding: 18px 0; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.5; }
  .season__list p:last-child { border-bottom: 1px solid var(--line); }
  .season__card { background: var(--cream); border-radius: var(--radius-card); padding: 40px; align-self: start; }
  .season__qs { display: flex; flex-direction: column; margin-top: 20px; }
  .season__q {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--line-2);
    align-items: baseline;
  }
  .season__q span { font-family: var(--font-serif); font-size: 20px; color: var(--gold); }
  .season__q p { font-family: var(--font-serif); font-size: 24px; line-height: 1.2; color: var(--brown); }
  .season__motto {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(24px, 2.6vw, 34px);
    color: var(--brown);
    text-align: center;
    margin: 64px auto 0;
    max-width: 820px;
    line-height: 1.3;
  }
</style>
