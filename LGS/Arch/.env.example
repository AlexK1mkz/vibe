# База. Без DATABASE_URL локально используется встроенный PGlite (.data/pglite).
DATABASE_URL=

# Адрес сайта для ссылок в сообщениях и Open Graph
SITE_URL=http://localhost:3000

# Админка: без пароля /admin закрыт
ADMIN_PASSWORD=

# GetCourse
GETCOURSE_ACCOUNT=
GETCOURSE_API_KEY=
GETCOURSE_OFFER_CONSULT=
GETCOURSE_OFFER_INTENSIVE=
GETCOURSE_OFFER_VIP=
# Секрет в адресе обратного вебхука об оплате: /api/webhooks/getcourse?secret=...
GETCOURSE_WEBHOOK_SECRET=

# WhatsApp: провайдер не выбран, по умолчанию заглушка с логом
WHATSAPP_PROVIDER=stub
WHATSAPP_API_KEY=

# CRM: полный объект лида при каждом изменении статуса
LEAD_WEBHOOK_URL=

# Крон цепочки сообщений: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Счётчики, загружаются после согласия в баннере cookie
META_PIXEL_ID=
GA4_ID=
YM_ID=
