---
import QuizApp from '../quiz/QuizApp';
import { quizSection } from '../../content/sections';
import { site } from '../../content/site';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="test" class="py-4" data-hide-fab>
  <div class="wrap">
    <div class="panel-deep rounded-[30px] px-4 py-10 sm:px-8 lg:rounded-[40px] lg:px-12 lg:py-16">
      <div class="on-dark">
        <SectionHead eyebrow={quizSection.eyebrow} title={quizSection.title} lead={quizSection.lead} />
      </div>
      <QuizApp client:idle />
      <p class="mt-8 text-center text-xs leading-relaxed text-white/60">
        Тест — самооценка по вашим ответам, это не диагноз. {site.disclaimer} Лицензия {site.legal.license}.
      </p>
    </div>
  </div>
</section>
