---
import { baseCheckup, checkupFocuses, extendedNote } from '../../content/checkups';
import { checkupsSection } from '../../content/sections';
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
let n = 0;
---
<section id="checkups" class="section bg-gradient-to-br from-aqua-soft via-brand-soft/60 to-now-soft">
  <div class="wrap">
    <SectionHead eyebrow={checkupsSection.eyebrow} title={checkupsSection.title} lead={checkupsSection.lead} />
    <div class="grid gap-4 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <article class="card reveal flex flex-col p-6 sm:p-8">
        <p class="eyebrow">{baseCheckup.name}</p>
        <h3 class="h3 mt-3 !text-[clamp(22px,2.4vw,28px)]">{baseCheckup.title}</h3>
        <p class="mt-3 text-muted">{baseCheckup.lead}</p>
        <ul class="mt-5 grid gap-2.5">
          {baseCheckup.includes.map((item) => (
            <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-goal" />{item}</li>
          ))}
        </ul>
        <dl class="mt-5 grid gap-3 border-t border-line pt-5 text-[15px]">
          <div class="grid grid-cols-[20px_1fr] gap-x-3">
            <dt class="col-start-2 font-semibold"><Icon name="clock" size={20} class="absolute -ml-8 mt-0.5 text-brand" />Срок готовности</dt>
            <dd class="col-start-2 text-muted">{baseCheckup.term}</dd>
          </div>
          <div class="grid grid-cols-[20px_1fr] gap-x-3">
            <dt class="col-start-2 font-semibold"><Icon name="flask" size={20} class="absolute -ml-8 mt-0.5 text-brand" />Подготовка</dt>
            <dd class="col-start-2 text-muted">{baseCheckup.prep}</dd>
          </div>
        </dl>
        <div class="mt-auto pt-7">
          <a class="btn btn-primary max-sm:w-full" href="#test" data-cta="checkups">{checkupsSection.cta}</a>
        </div>
      </article>
      <div class="card reveal p-6 sm:p-8">
        <h3 class="h3">Что входит в базовый чекап</h3>
        <div class="mt-5 grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {baseCheckup.groups.map((group) => (
            <div>
              <h4 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-brand">{group.title}</h4>
              <ul class="mt-2 grid gap-1.5 text-[15px]">
                {group.items.map((item) => (
                  <li class="flex gap-3"><span class="w-5 shrink-0 text-xs font-semibold leading-6 text-muted tabular-nums">{String(++n).padStart(2, '0')}</span>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <h3 class="h3 reveal mt-12">{checkupsSection.focusTitle}</h3>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {checkupFocuses.map((f) => (
        <li class="reveal rounded-3xl border border-line bg-surface p-5">
          <p class="font-display text-lg font-bold">{f.name}</p>
          <p class="text-sm text-muted">{f.question}</p>
          <p class="mt-3 flex flex-wrap gap-1.5">
            {f.markers.map((m) => <span class="rounded-full bg-brand-soft px-2.5 py-1 text-[13px] font-medium text-brand-deep">{m}</span>)}
          </p>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm text-muted">{extendedNote}.</p>
  </div>
</section>
