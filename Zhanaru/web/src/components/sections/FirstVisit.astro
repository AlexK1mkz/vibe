---
import { firstVisit } from '../../content/sections';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="first-visit" class="section !pt-0">
  <div class="wrap">
    <SectionHead eyebrow={firstVisit.eyebrow} title={firstVisit.title} />
    <ol class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      {firstVisit.steps.map((step, i) => (
        <li class="reveal flex gap-4 rounded-3xl border border-line bg-surface p-4 sm:block sm:p-6">
          <span class:list={[`chip-${['aqua', 'amber', 'lilac', 'green'][i]}`, 'grid size-10 shrink-0 place-items-center rounded-full font-display font-bold sm:size-11']}>{i + 1}</span>
          <div>
            <h3 class="font-display text-lg font-bold sm:mt-4">{step.title}</h3>
            <p class="mt-1 text-[15px] text-muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <ul class="reveal mt-6 grid gap-1 text-[15px] text-muted">
      {firstVisit.notes.map((note) => <li>{note}</li>)}
    </ul>
  </div>
</section>
