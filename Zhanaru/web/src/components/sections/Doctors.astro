---
import { doctors, doctorsNote } from '../../content/doctors';
import { doctorsSection } from '../../content/sections';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="doctors" class="section bg-surface">
  <div class="wrap">
    <SectionHead {...doctorsSection} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {doctors.map((d) => (
        <article class="reveal flex overflow-hidden rounded-3xl border border-line bg-surface sm:flex-col">
          <div class="aspect-square w-[116px] shrink-0 bg-gradient-to-b from-white to-brand-soft sm:w-full">
            <img src={d.photo} alt={`${d.name}, ${d.role.toLowerCase()}`} width="400" height="400" loading="lazy" decoding="async" class="size-full object-cover object-top" />
          </div>
          <div class="flex flex-col gap-2 p-4 sm:p-5">
            <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-brand">{d.role}</p>
            <h3 class="font-display text-xl font-bold leading-tight">{d.name}</h3>
            {d.badges && (
              <p class="flex flex-wrap gap-1.5">
                {d.badges.map((b) => <span class="rounded-full bg-brand px-2.5 py-1 text-xs font-semibold text-white">{b}</span>)}
              </p>
            )}
            <ul class="grid gap-1 text-sm text-muted">
              {d.focus.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <p class="reveal mt-6 max-w-3xl text-muted">{doctorsNote}</p>
  </div>
</section>
