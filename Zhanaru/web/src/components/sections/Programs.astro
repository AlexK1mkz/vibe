---
import { programs } from '../../content/sections';
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="programs" class="section">
  <div class="wrap">
    <SectionHead eyebrow={programs.eyebrow} title={programs.title} lead={programs.lead} />
    <div class="grid gap-4 lg:grid-cols-3">
      {programs.items.map((p, i) => (
        <article class:list={['reveal flex flex-col gap-4 rounded-[28px] p-6 sm:p-8', i === 1 ? 'panel-deep on-dark shadow-float' : 'card']}>
          <p class:list={['w-max rounded-full px-3.5 py-1.5 font-display text-sm font-bold', i === 1 ? 'bg-sun text-[#1B1405]' : 'bg-brand-soft text-brand-deep']}>{p.term}</p>
          <h3 class="h3">{p.title}</h3>
          <p class={i === 1 ? 'text-white/80' : 'text-muted'}>{p.text}</p>
          <ul class:list={['grid gap-2 border-t pt-4 text-[15px]', i === 1 ? 'border-white/15' : 'border-line']}>
            {p.includes.map((item) => (
              <li class="flex gap-3"><Icon name="check" size={18} class={i === 1 ? 'mt-0.5 shrink-0 text-sun' : 'mt-0.5 shrink-0 text-goal'} />{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="reveal mt-6 text-muted">{programs.note}</p>
  </div>
</section>
