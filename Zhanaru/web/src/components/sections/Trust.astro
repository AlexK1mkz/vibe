---
import { trust } from '../../content/sections';
import { site } from '../../content/site';
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="trust" class="section !pt-0">
  <div class="wrap">
    <SectionHead eyebrow={trust.eyebrow} title={trust.title} />
    <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {trust.items.map((item, i) => (
        <li class="reveal flex gap-4">
          <span class:list={[`chip-${['aqua', 'green', 'amber', 'sky', 'lilac', 'peach'][i % 6]}`, 'grid size-12 shrink-0 place-items-center rounded-2xl']}><Icon name={item.icon} /></span>
          <div>
            <h3 class="font-display text-lg font-bold">{item.title}</h3>
            <p class="mt-1 text-[15px] text-muted">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="reveal mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-3xl border border-line bg-surface px-6 py-5 text-[15px] text-muted">
      <span>Лаборатории-партнёры:</span>
      <ul class="grid w-full grid-cols-2 gap-3 sm:flex sm:w-auto sm:flex-wrap sm:items-center">
        {site.labs.map((lab) => (
          <li class="grid h-16 place-items-center rounded-2xl bg-white px-3 ring-1 ring-line sm:min-w-[170px] sm:px-4">
            <img
              src={lab.logo}
              alt={`Лаборатория ${lab.name}`}
              width={lab.w}
              height={lab.h}
              loading="lazy"
              decoding="async"
              style={`height:${lab.height}px;width:auto;max-width:100%;object-fit:contain`}
            />
          </li>
        ))}
      </ul>
      <span>Анализы сдаются прямо в клинике</span>
    </div>
  </div>
</section>
