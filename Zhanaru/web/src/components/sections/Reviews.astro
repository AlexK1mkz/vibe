---
import { reviews } from '../../content/sections';
import { site } from '../../content/site';
import Icon from '../ui/Icon.astro';
---
<section id="reviews" class="section !pt-0">
  <div class="wrap">
    <div class="card reveal grid items-center gap-8 p-6 sm:p-10 lg:grid-cols-[auto_1fr] lg:gap-16 lg:p-14">
      <div class="text-center">
        <p class="font-display text-[clamp(72px,9vw,104px)] font-bold leading-none text-brand">{site.gis.rating.toFixed(1).replace('.', ',')}</p>
        <p class="mt-3 flex justify-center gap-1 text-now" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={22} class="fill-current" />)}
        </p>
        <p class="mt-2 text-sm text-muted">{site.gis.ratings} оценки · {site.gis.reviews} отзыва в 2ГИС<br />по данным на {site.gis.checkedAt}</p>
      </div>
      <div>
        <p class="eyebrow">{reviews.eyebrow}</p>
        <h2 class="h2 mt-3">{reviews.title}</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {reviews.chips.map((chip) => <li class="rounded-full bg-brand-soft px-4 py-2 text-[15px] font-medium text-brand-deep">{chip}</li>)}
        </ul>
        <a class="btn btn-ghost mt-7" href={site.gis.reviewsUrl} target="_blank" rel="noopener" data-cta="reviews">{reviews.cta}</a>
      </div>
    </div>
  </div>
</section>
