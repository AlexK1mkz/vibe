---
import { mission } from '../../content/sections';
---
<section id="mission" class="section !pt-0">
  <div class="wrap">
    <div class="reveal rounded-[32px] bg-gradient-to-br from-now-soft via-brand-soft to-aqua-soft px-6 py-12 text-center sm:px-12 lg:py-20">
      <p class="eyebrow">{mission.eyebrow}</p>
      <h2 class="h2 mx-auto mt-4 max-w-3xl">{mission.title}</h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-ink/80">{mission.text}</p>
      <p class="mt-6 font-display font-semibold text-brand-deep">{mission.signature}</p>
    </div>
  </div>
</section>
