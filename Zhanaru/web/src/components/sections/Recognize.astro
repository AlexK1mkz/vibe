---
import { recognize } from '../../content/sections';
import Icon from '../ui/Icon.astro';
---
<section class="section !pb-16 !pt-12" aria-labelledby="recognize-title">
  <div class="wrap">
    <div class="reveal mb-8 grid gap-3">
      <h2 id="recognize-title" class="h2">{recognize.title}</h2>
      <p class="lead">{recognize.lead}</p>
    </div>
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-3 lg:gap-4">
      {recognize.cards.map((card) => (
        <li class="reveal">
          <a href="#test" data-quiz-goal={card.goal} data-cta="recognize"
            class:list={[`tint-${card.tone}`, 'group flex h-full flex-col justify-between gap-6 rounded-[28px] p-5 shadow-soft transition-transform duration-300 ease-out hover:-translate-y-1 sm:p-6']}>
            <span class:list={[`chip-${card.tone}`, 'grid size-12 place-items-center rounded-2xl']}><Icon name={card.icon} /></span>
            <span class="flex items-end justify-between gap-3 font-display text-[17px] font-semibold leading-snug sm:text-xl">
              {card.text}
              <Icon name="arrow-right" size={20} class="shrink-0 text-ink/50 transition-transform duration-300 group-hover:translate-x-1 max-sm:hidden" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
