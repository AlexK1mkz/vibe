                    this.color = this.isMenuFilledDark ? 'light' : this.getInvertedColor(this.themeColor);

                    this.bindEvents();
                }
            }
        },

        getInvertedColor: function(value) {
            if (value === 'default') {
                value = this.preferColor;
            }

            return value === 'light' ? 'dark' : (value === 'dark' ? 'light' : '');
        },

        bindEvents: function() {
