            },

            onChangeThemeColor: function(eventdata) {
                if (
                    typeof eventdata === 'object' &&
                    eventdata &&
                    'value' in eventdata
                ) {
                    this.color = this.getInvertedColor(eventdata.value);
                }
            },
        }
    }

