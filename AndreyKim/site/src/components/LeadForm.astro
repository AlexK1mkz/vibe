---
import { ArrowRight, LoaderCircle } from '@lucide/astro';
import Brand from './Brand.astro';
import { site } from '../data/site';

const channels = [
  { value: 'whatsapp', label: 'WhatsApp' },
  { value: 'telegram', label: 'Telegram' },
  { value: 'call', label: 'Звонок' },
];
---

<form
  id="lead-form"
  action="/api/lead"
  method="post"
  novalidate
  class="rounded-3xl bg-surface p-5 text-ink shadow-[0_30px_80px_-40px_rgb(0_0_0/0.6)] sm:p-8"
>
  <div class="space-y-4 sm:space-y-5">
    <div>
      <label for="lead-name" class="mb-2 block text-[0.9375rem] font-medium">Имя</label>
      <input
        id="lead-name"
        name="name"
        type="text"
        autocomplete="given-name"
        required
        minlength="2"
        maxlength="80"
        aria-describedby="lead-name-error"
        class="field"
      />
      <p id="lead-name-error" class="field-error" hidden>Напишите, как к вам обращаться — от двух букв.</p>
    </div>

    <div>
      <label for="lead-phone" class="mb-2 block text-[0.9375rem] font-medium">Телефон</label>
      <input
        id="lead-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        placeholder="+7 (___) ___-__-__"
        aria-describedby="lead-phone-error"
        class="field"
      />
      <p id="lead-phone-error" class="field-error" hidden>Проверьте номер: после +7 должно быть 10 цифр.</p>
    </div>

    <fieldset>
      <legend class="mb-2 text-[0.9375rem] font-medium">Как удобнее связаться</legend>
      <div class="grid grid-cols-3 gap-1 rounded-xl border border-line bg-paper p-1">
        {
          channels.map((c, i) => (
            <label class="channel">
              <input type="radio" name="channel" value={c.value} checked={i === 0} class="sr-only" />
              <span>{c.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div>
      <label for="lead-message" class="mb-2 flex items-baseline justify-between gap-3 text-[0.9375rem] font-medium">
        Что сейчас важно разобрать?
        <span class="font-normal text-muted">необязательно</span>
      </label>
      <textarea
        id="lead-message"
        name="message"
        rows="2"
        maxlength="1000"
        placeholder="Например: всё держу на себе, команда не растёт"
        class="field resize-y"></textarea>
    </div>

    <!-- Ловушка для ботов: людям не видна -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Компания <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    {
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'referrer', 'page_url'].map((n) => (
        <input type="hidden" name={n} />
      ))
    }
  </div>

  <button type="submit" class="btn btn-primary group mt-6 w-full" data-submit>
    <span data-label>Записаться на встречу</span>
    <ArrowRight size={20} class="submit-arrow transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    <LoaderCircle size={20} class="submit-spinner hidden animate-spin" aria-hidden="true" />
  </button>

  <p id="lead-status" role="alert" class="mt-4 hidden rounded-xl bg-accent-soft px-4 py-3 text-[0.9375rem] text-ink"></p>

  <p class="mt-4 text-[0.875rem] leading-relaxed text-muted">
    Андрей свяжется с вами в течение рабочего дня. Никаких рассылок — один контакт по вашей заявке. Нажимая
    кнопку, вы соглашаетесь с <a href="/politika" class="underline underline-offset-2 hover:text-accent"
      >политикой конфиденциальности</a
    >.
  </p>

  <div class="my-4 flex items-center gap-4 sm:my-6 text-[0.875rem] text-muted" aria-hidden="true">
    <span class="h-px flex-1 bg-line"></span>или<span class="h-px flex-1 bg-line"></span>
  </div>

  <a href={site.whatsapp} target="_blank" rel="noopener" data-wa="form" class="btn btn-outline w-full">
    <Brand name="whatsapp" size={20} />
    Написать в WhatsApp
  </a>
</form>

<style is:global>
  .field {
    display: block;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    border: 1.5px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 1.0625rem; /* ≥16px — iOS не зумит поле */
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .field::placeholder {
    color: #8a93a0;
  }
  .field:hover {
    border-color: #b9b0a0;
  }
  .field:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(191 74 36 / 0.16);
    border-radius: 0.875rem;
  }
  .field[aria-invalid='true'] {
    border-color: #b3261e;
  }
  .field-error {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #b3261e;
  }
  .channel {
    cursor: pointer;
  }
  .channel span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .channel input:checked + span {
    background: var(--color-ink);
    color: #fff;
  }
  .channel input:focus-visible + span {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  #lead-form[data-loading] .submit-arrow {
    display: none;
  }
  #lead-form[data-loading] .submit-spinner {
    display: block;
  }
  #lead-form[data-loading] [data-submit] {
    pointer-events: none;
    opacity: 0.85;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#lead-form');
  if (form) {
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const status = form.querySelector<HTMLElement>('#lead-status')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const defaultLabel = label.textContent || '';

    // UTM и источник — в скрытые поля
    const params = new URLSearchParams(location.search);
    const setHidden = (key: string, value: string) => {
      const el = form.elements.namedItem(key) as HTMLInputElement | null;
      if (el) el.value = value.slice(0, 300);
    };
    for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content']) {
      const fromUrl = params.get(key);
      if (fromUrl) sessionStorage.setItem(key, fromUrl);
      setHidden(key, fromUrl || sessionStorage.getItem(key) || '');
    }
    setHidden('referrer', document.referrer);
    setHidden('page_url', location.origin + location.pathname);

    // Маска +7 (XXX) XXX-XX-XX
    const digitsOf = (value: string) => {
      let d = value.replace(/\D/g, '');
      if (d.length > 10 && (d[0] === '7' || d[0] === '8')) d = d.slice(1);
      else if (value.trim().startsWith('+7')) d = d.slice(1);
      return d.slice(0, 10);
    };
    const format = (d: string) => {
      if (!d) return '';
      let out = '+7 (' + d.slice(0, 3);
      if (d.length >= 3) out += ') ' + d.slice(3, 6);
      if (d.length >= 6) out += '-' + d.slice(6, 8);
      if (d.length >= 8) out += '-' + d.slice(8, 10);
      return out;
    };
    phone.addEventListener('focus', () => {
      if (!phone.value) phone.value = '+7 (';
    });
    phone.addEventListener('blur', () => {
      if (digitsOf(phone.value).length === 0) phone.value = '';
    });
    phone.addEventListener('input', (e) => {
      const deleting = (e as InputEvent).inputType?.startsWith('delete');
      const d = digitsOf(phone.value);
      // при удалении не возвращаем хвостовые скобки и дефисы
      phone.value = deleting ? format(d).replace(/[\s()-]+$/, '') || '+7 (' : format(d) || '+7 (';
    });

    const setError = (input: HTMLInputElement, invalid: boolean) => {
      input.setAttribute('aria-invalid', String(invalid));
      const err = document.getElementById(input.id + '-error');
      if (err) err.hidden = !invalid;
      return invalid;
    };
    const validName = () => !setError(name, name.value.trim().length < 2);
    const validPhone = () => !setError(phone, digitsOf(phone.value).length !== 10);
    name.addEventListener('blur', () => name.value && validName());
    phone.addEventListener('blur', () => digitsOf(phone.value).length && validPhone());

    let started = false;
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      window.track('form_start');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const okName = validName();
      const okPhone = validPhone();
      if (!okName || !okPhone) {
        (okName ? phone : name).focus();
        return;
      }

      form.toggleAttribute('data-loading', true);
      label.textContent = 'Отправляем…';
      status.classList.add('hidden');
      window.track('form_submit');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        label.textContent = 'Заявка принята';
        location.assign('/spasibo');
      } catch (err) {
        form.toggleAttribute('data-loading', false);
        label.textContent = defaultLabel;
        status.textContent =
          'Не получилось отправить заявку. Попробуйте ещё раз или напишите в WhatsApp — кнопка ниже.';
        status.classList.remove('hidden');
      }
    });
  }
</script>
