---
import Brand from './Brand.astro';
import { site } from '../data/site';
---

<!-- Мобильный бар: появляется, когда кнопка первого экрана ушла из вида, и прячется у формы -->
<div
  id="sticky-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-paper/95 px-4 pt-3 backdrop-blur-md transition-transform duration-300 data-[show]:translate-y-0 md:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))"
  inert
>
  <div class="flex gap-2.5">
    <a href="/#zayavka" data-cta="sticky" class="btn btn-primary !min-h-[3.25rem] flex-1 !px-4">
      Записаться на встречу
    </a>
    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      data-wa="sticky"
      aria-label="Написать в WhatsApp"
      class="btn btn-outline !min-h-[3.25rem] !border-ink/20 !px-4"
    >
      <Brand name="whatsapp" size={22} />
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-bar');
  const heroCta = document.querySelector('[data-cta="hero"]');
  const formSection = document.getElementById('zayavka');
  if (bar && heroCta && formSection && 'IntersectionObserver' in window) {
    let pastHero = false;
    let atForm = false;
    const update = () => {
      const show = pastHero && !atForm;
      bar.toggleAttribute('data-show', show);
      bar.toggleAttribute('inert', !show);
    };
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }).observe(heroCta);
    new IntersectionObserver(
      ([e]) => {
        atForm = e.isIntersecting;
        update();
      },
      { threshold: 0.15 },
    ).observe(formSection);
  }
</script>
