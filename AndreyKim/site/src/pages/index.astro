<style is:global>
  /* Подчёркнутая «петля» в заголовке первого экрана */
  .hero-loop {
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 100% 0.09em;
    background-position: 0 96%;
    padding-bottom: 0.04em;
  }
  .method summary:hover > span:last-child {
    border-color: var(--color-ink);
  }
</style>

<script>
  // Видео: постер + кнопка, плеер подгружается только по клику
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const box = btn.closest('[data-video-box]');
      if (!box) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.video}?autoplay=1&rel=0&cc_load_policy=1`;
      iframe.title = 'Видео';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 size-full';
      box.appendChild(iframe);
      btn.remove();
    });
  });
</script>
